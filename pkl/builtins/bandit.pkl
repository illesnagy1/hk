import "../Builtins.pkl"
import "../Config.pkl"
import "./test/helpers.pkl"

local const badFile =
  """
  import subprocess


  def run(cmd):
      subprocess.call(cmd, shell=True)

  """

@Builtins.meta {
  category = "Python"
  description = "Python security linter"
  project_indicators {
    new { file = ".bandit" }
    new { file = "pyproject.toml"; contains_regex = #"^[ \t]*\[tool\.bandit[\].]"# }
  }
}
bandit = new Config.Step {
  glob = List("**/*.py", "**/*.pyw")
  // bandit only finds a `.bandit` file when it scans directories, and reads
  // pyproject.toml only when passed `-c`, so pass the project's config at
  // the root explicitly. `-q` drops bandit's log lines and prints nothing
  // when no issues are found; findings keep bandit's default format.
  check = new Config.CommandSpec {
    command =
      #"""
      set -- -q
      if [ -f .bandit ]; then set -- "$@" --ini .bandit; fi
      if [ -f pyproject.toml ] && grep -Eq '^[[:space:]]*\[tool\.bandit[].]' pyproject.toml; then
      set -- "$@" -c pyproject.toml
      fi
      bandit "$@" {{ files }}
      """#
    effect = "read"
  }
  tests {
    local const testMaker = new helpers.TestMaker { filename = "test.py" }
    ["check good file"] = testMaker.checkPass("x = 1\n")
    ["check bad file"] = testMaker.checkFail(badFile, 1)
    ["check bad pyw file"] = testMaker.withFilename("test.pyw").checkFail(badFile, 1)
    ["check uses pyproject.toml config"] =
      (testMaker) {
        extra_files {
          ["pyproject.toml"] =
            """
            [project]
            name = "example"

            [tool.bandit]
            skips = ["B404", "B602"]

            """
        }
      }.checkPass(badFile)
    ["check ignores pyproject.toml without bandit config"] =
      (testMaker) {
        extra_files {
          ["pyproject.toml"] =
            """
            [project]
            name = "example"

            """
        }
      }.checkFail(badFile, 1)
    ["check uses .bandit config"] =
      (testMaker) {
        extra_files {
          [".bandit"] =
            """
            [bandit]
            skips = B404,B602

            """
        }
      }.checkPass(badFile)
  }
}
